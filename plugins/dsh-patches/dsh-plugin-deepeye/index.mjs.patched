/** Fallback text when vision translation fails; keeps the session usable. */
const FALLBACK_TEMPLATE = (index) => `[用户粘贴了一张图片（图片 ${index}），但视觉翻译失败，图片内容不可见。请告知用户当前模型无法直接查看图片，可建议其截图后使用 vision_clipboard 工具分析剪贴板。]`;
