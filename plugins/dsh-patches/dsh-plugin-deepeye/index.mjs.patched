			render: (_args, value) => [{
				type: "text",
				text: value
			}]
		},
		presentCall(args) {
			return {
				card: "generic",
				title: `Layout analysis (${args.detail || "basic"}): ${shortPath(args.image_source)}`,
				kind: "read",
				locations: isLocalPath(args.image_source) ? [{ path: locationPath(args.image_source) }] : void 0
			};
		},
		presentResult(args, result) {
			return {
				card: "generic",
				title: `Layout JSON: ${shortPath(args.image_source)}`,
				content: result.content
			};
		},
		async execute(args, exec) {
			const prompt = (args.detail || "basic") === "detailed" ? LAYOUT_BASIC_PROMPT + LAYOUT_DETAILED_EXTRA : LAYOUT_BASIC_PROMPT;
			const parsed = extractLayoutJson(await engine.run(args.image_source, prompt, args.model || void 0, exec.signal));
			return JSON.stringify(parsed, null, 2);
		}
	})));
	disposers.push(ctx.tools.register(defineTool({
		name: "vision_clipboard",
		description: "Analyze the latest image in the system clipboard (no paste needed). User takes a screenshot, then this tool analyzes it directly.",
		parameters: {
			prompt: {
				type: "string",
				description: "Optional analysis prompt. Defaults to screenshot description."
			},
			model: {
				type: "string",
				description: "Optional model name override for this call."
			}
		},
		output: {
			schema: { type: "string" },
			render: (_args, value) => [{
				type: "text",
				text: value
			}]
		},
		presentCall() {
			return {
				card: "generic",
				title: "Analyze clipboard screenshot",
				kind: "read"
			};
		},
		presentResult(_args, result) {
			return {
				card: "generic",
				title: "Clipboard analysis result",
				content: result.content
			};
		},
		async execute(args, exec) {
			const snapshot = await grabClipboardImage(exec.signal);
			if (snapshot.kind === "empty") return "剪贴板中没有图片。请先截图（如 Win+Shift+S 会自动复制到剪贴板）或复制一张图片后再试。";
			if (snapshot.kind === "text") return `剪贴板中当前是文本而不是图片，本工具无法分析：${JSON.stringify(snapshot.textPreview)}…\n请先截图（如 Win+Shift+S）或用含图片的剪贴板内容，再调用本工具。`;
			if (snapshot.kind === "error") return `读取剪贴板失败：${snapshot.detail} 请确认系统剪贴板可用后重试。`;
			const prompt = args.prompt || CLIPBOARD_DESCRIBE_PROMPT;
			return `剪贴板图片分析结果：\n${await engine.runRaw(snapshot.base64, "image/png", prompt, args.model || void 0, exec.signal)}`;
		}
	})));
	let disposed = false;
	return () => {
		if (disposed) return;
		disposed = true;
		for (const dispose of [...disposers].reverse()) dispose();
	};
}
/**
* Public Cordis entry point.
*
* If plugin setup fails part-way through, already-registered effects are
* rolled back so a later reload/retry does not start from a half-initialized
* plugin state.
*/
function apply(ctx, config) {
	const disposers = [];
	try {
		return applyPlugin(ctx, config, disposers);
	} catch (error) {
		for (const dispose of [...disposers].reverse()) dispose();
		throw error;
	}
}
/** PowerShell script that reports clipboard content with a kind prefix. */
const CLIPBOARD_PROBE_SCRIPT = `
Add-Type -AssemblyName System.Windows.Forms
$img = [System.Windows.Forms.Clipboard]::GetImage()
if ($img -ne $null) {
  $ms = New-Object System.IO.MemoryStream
  $img.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png)
  Write-Output ("IMG:" + [Convert]::ToBase64String($ms.ToArray()))
} else {
  $txt = [System.Windows.Forms.Clipboard]::GetText()
  if ($txt -ne $null -and $txt.Length -gt 0) {
    $p = $txt.Substring(0, [Math]::Min(60, $txt.Length)) -replace "[\\r\\n]+", " "
    Write-Output ("TXT:" + $p)
  } else {
    Write-Output "NONE"
  }
}`;
/**
* Run the clipboard probe as an async child process.
*
* Uses `-EncodedCommand` (UTF-16LE base64) so the inline script needs no
* shell-quoting; spawns instead of execSync so the host event loop is never
* blocked, and honors the tool's AbortSignal for true cancellation.
*/
function runClipboardProbe(signal, timeoutMs = 1e4) {
	return new Promise((resolve, reject) => {
		const encoded = Buffer.from(CLIPBOARD_PROBE_SCRIPT, "utf16le").toString("base64");
		const child = spawn("powershell", [
			"-NoProfile",
			"-Sta",
			"-EncodedCommand",
			encoded
		], {
			windowsHide: true,
			stdio: [
				"ignore",
				"pipe",
				"pipe"
			]
		});
		let stdout = "";
		let stderr = "";
		let settled = false;
		child.stdout.on("data", (chunk) => {
			stdout += chunk;
		});
		child.stderr.on("data", (chunk) => {
			stderr += chunk;
		});
		const finish = (fn) => {
			if (settled) return;
			settled = true;
			clearTimeout(timer);
			signal?.removeEventListener("abort", onAbort);
			fn();
		};
		const timer = setTimeout(() => {
			child.kill();
			finish(() => reject(/* @__PURE__ */ new Error(`读取剪贴板超时（${timeoutMs}ms）`)));
		}, timeoutMs);
		const onAbort = () => {
			child.kill();
			finish(() => reject(signal?.reason ?? /* @__PURE__ */ new Error("剪贴板读取已取消")));
		};
		if (signal) {
			if (signal.aborted) {
				child.kill();
				finish(() => reject(signal.reason ?? /* @__PURE__ */ new Error("剪贴板读取已取消")));
				return;
			}
			signal.addEventListener("abort", onAbort, { once: true });
		}
		child.on("error", (error) => finish(() => reject(error)));
		child.on("close", (code) => {
			if (code === 0) finish(() => resolve(stdout.trim()));
			else finish(() => reject(new Error(stderr.trim() || `读取剪贴板失败（退出码 ${code}）`)));
		});
	});
}
/**
* Grab an image from the system clipboard (Windows).
*
* Non-blocking and cancellable: spawns a PowerShell probe and resolves with a
* classified snapshot (image / text / empty / error). On other platforms it
* reports an unsupported error instead of silently returning null.
*/
async function grabClipboardImage(signal) {
	if (process.platform !== "win32") return {
		kind: "error",
		detail: "当前平台不支持剪贴板读取（仅 Windows）。"
	};
	let output;
	try {
		output = await runClipboardProbe(signal);
	} catch (error) {
		if (signal?.aborted) throw error;
		return {
			kind: "error",
			detail: messageOf(error)
		};
	}
	const firstLine = output.replace(/^\uFEFF/, "").split(/\r?\n/, 1)[0] ?? "";
	if (firstLine.startsWith("IMG:")) {
		const base64 = firstLine.slice(4).trim();
		if (base64) return {
			kind: "image",
			base64
		};
		return {
			kind: "error",
			detail: "剪贴板图片读取为空。"
		};
	}
	if (firstLine.startsWith("TXT:")) return {
		kind: "text",
		textPreview: firstLine.slice(4).trim()
	};
	return { kind: "empty" };
}
