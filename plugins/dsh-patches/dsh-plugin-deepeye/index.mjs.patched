		case "gemini": return new GeminiAdapter({
			apiKey,
			baseUrl: config.baseUrl || void 0,
			model: effectiveModel,
			maxTokens: config.maxTokens,
			timeoutMs: config.requestTimeout,
			maxRetries: config.maxRetries,
			retryDelay: config.retryDelay
