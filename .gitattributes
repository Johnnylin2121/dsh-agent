# 换行与编码：双端（Windows / macOS）统一 LF，避免 CRLF 噪声 diff
* text=auto eol=lf

# 明确文本类型
*.md   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ps1  text eol=lf
*.sh   text eol=lf
*.py   text eol=lf

# 二进制：不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff binary
*.woff2 binary
