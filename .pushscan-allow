# push-scan 引擎自身包含检测正则字面量, 属预期自命中, 按内容放行
re='
# 2026-09-15: domain-memory 里那句「本机 vault 实路径」已脱敏删除; 删除行仍会进 patch
# 而被 VAULT-PATH 命中(内容已在远程历史, 非本次新泄露)。仅放行「当前为 ...」这一句的删除。
rule=VAULT-PATH.*当前为
# 2026-09-16 双端化提交: 本次删除的正是「写死的 Windows 解释器/spill 路径」(修复本身),
# 删除行带 '-' 前缀仍会被 LOCAL-PATH 命中。仅放行带删除前缀的行, 新增行不受影响。
rule=LOCAL-PATH\s+-.*python\.exe
rule=LOCAL-PATH\s+-.*dsh-spill
# 2026-09-17 脱敏提交 fix(privacy): 本次删除的内容正是真实 ASIN 与持仓价格动作(修复本身),
# 其删除行带 '-' 前缀, 仍会被 ASIN / PRICE-ACTION 命中(新增行不受影响)。
# 仅放行带删除前缀的行; 任何新增的 ASIN/价格动作仍会被拦。
rule=ASIN\s+-
rule=PRICE-ACTION\s+-
